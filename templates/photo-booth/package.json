{
  "name": "electrobun-photo-booth",
  "version": "1.0.0",
  "description": "A photo booth app demonstrating getUserMedia with Electrobun",
  "scripts": {
    "start": "node api.js && electrobun dev",
    "dev": "node api.js && electrobun dev --watch",
    "build:canary": "electrobun build --env=canary"
  },
  "dependencies": {
    "electrobun": "file:../../package"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
